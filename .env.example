# === Anthropic API ===
# Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# === OpenAI API (для DALL-E 3) ===
# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# === Telegram Bot ===
# Получить токен: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890

# === Конфигурация моделей агентов ===
RESEARCHER_MODEL=claude-opus-5
COPYWRITER_MODEL=claude-opus-5
DESIGNER_MODEL=claude-opus-5
TELEGRAM_AGENT_MODEL=claude-opus-5
EDITOR_MODEL=claude-opus-5

# === DALL-E 3 настройки ===
# Модель: dall-e-3 (оптимальное качество)
# Размер: 1024x1024, 1792x1024, 1024x1792
# Качество: standard (быстрее), hd (выше качество)
DALLE_MODEL=dall-e-3
DALLE_SIZE=1024x1024
DALLE_QUALITY=standard

# === Логирование ===
LOG_LEVEL=INFO

# === Хранилище ===
STATE_DIR=./state
OUTPUT_DIR=./outputs
